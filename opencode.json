{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx.cmd",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/Users/khdan_yksn3uv/Documents/Opencode/CRM Apps"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx.cmd", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "environment": {
        "MEMORY_FILE_PATH": "C:/Users/khdan_yksn3uv/Documents/Opencode/CRM Apps/.opencode/memory.jsonl"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx.cmd", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": false
    },
    "fetch": {
      "type": "local",
      "command": ["npx.cmd", "-y", "@modelcontextprotocol/server-fetch"],
      "enabled": false
    },
    "sqlite": {
      "type": "local",
      "command": [
        "npx.cmd",
        "-y",
        "mcp-server-sqlite",
        "--db",
        "C:/Users/khdan_yksn3uv/Documents/Opencode/CRM Apps/database.db"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx.cmd", "-y", "@playwright/mcp@latest"],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    }
  }
}
